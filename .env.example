# MongoDB Atlas 연결 문자열 (필수)
# https://cloud.mongodb.com 에서 클러스터 생성 후 "Connect" > "Drivers" 의 URI 를 붙여넣으세요.
# 예: mongodb+srv://<user>:<password>@<cluster>.xxxxx.mongodb.net/todo?retryWrites=true&w=majority
MONGODB_URI=

# 세션 JWT 서명 키 (필수, 최소 16자). 생성: openssl rand -base64 32
AUTH_SECRET=

# GitHub OAuth App (필수). https://github.com/settings/developers 에서 생성
# Authorization callback URL: http://localhost:3000/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# 콜백 URL (선택). 미설정 시 요청 origin + /auth/github/callback 로 자동 계산.
# 리버스 프록시/커스텀 도메인 뒤에서 실행할 때만 명시적으로 지정하세요.
GITHUB_CALLBACK_URL=
